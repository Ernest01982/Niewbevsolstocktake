{
  "name": "ai-stock-take-control-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, multi-company stock-taking SaaS",
  "engines": {
    "node": ">=22.20.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @stock-take/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types --lang typescript --local --schema public > apps/web/src/types/database.types.ts && node scripts/normalize-database-types.mjs",
    "dev": "npm run dev --workspace @stock-take/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.10.0",
    "prettier": "3.9.6",
    "supabase": "2.113.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
